# Any OpenAI-compatible chat endpoint. Only needed for live runs; TRACE_MODE=replay needs none.
# The capstone results were recorded through a Cloudflare AI Gateway route; OpenAI, Cloudflare Workers AI
# (https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1) or a local Ollama (http://localhost:11434/v1) also work.
LLM_BASE_URL=
LLM_API_KEY=
# Optional overrides (defaults chosen by experiments E1/E2):
# AGENT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# CHECKER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# EMBED_MODEL=BAAI/bge-base-en-v1.5
# TRACE_MODE=auto   # auto | replay | live
